APP_ENV=development
ADMIN_PASSWORD=abc
# Stable random secret used to sign 24-hour participant API sessions; use at least 32 characters.
PARTICIPANT_SESSION_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
BACKEND_NETWORK_MODE=host
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/ai_tutor
AI_BACKEND=codex_app_server
# URL used by the backend container/host-network backend to reach the app-server.
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
# URL used by scripts/start-codex-app-server.* on the host.
CODEX_APP_SERVER_LISTEN_URL=ws://127.0.0.1:4500
CODEX_WS_TOKEN_FILE=
CODEX_MODEL=gpt-6-luna
CODEX_APP_SERVER_CWD=/tmp
CODEX_TURN_TIMEOUT_SEC=120
CODEX_REASONING_EFFORT=low

# Legacy mapping store retained only for cleanup of rows from prior versions.
# New registrations do not open this SQLite file; the primary identifier is participant_code.
# Docker Compose mounts the legacy path at /identity-mappings/mappings.sqlite3.
IDENTITY_MAPPING_PATH=./.private-identities/mappings.sqlite3
RAG_BASE_DIR=/rag_agent_knowledge_base
FRONTEND_INTERNAL_API_BASE_URL=http://host.docker.internal:8000
NEXT_PUBLIC_API_BASE_URL=
MAX_LEARNING_TARGETS=3
MAX_TURNS_PER_TERM=3
EXPORT_DIR=/app/exports
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ai_tutor
POSTGRES_PORT=5432
